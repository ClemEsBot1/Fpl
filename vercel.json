{
  "crons": [
    {
      "path": "/api/refresh-optimal",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/fpl-best-goalkeepers",
      "destination": "/api/optimal-squad?page=position&pos=goalkeepers"
    },
    {
      "source": "/fpl-best-defenders",
      "destination": "/api/optimal-squad?page=position&pos=defenders"
    },
    {
      "source": "/fpl-best-midfielders",
      "destination": "/api/optimal-squad?page=position&pos=midfielders"
    },
    {
      "source": "/fpl-best-forwards",
      "destination": "/api/optimal-squad?page=position&pos=forwards"
    },
    {
      "source": "/fpl-budget-players",
      "destination": "/api/optimal-squad?page=budget"
    },
    {
      "source": "/fpl-fixture-difficulty",
      "destination": "/api/optimal-squad?page=fixtures"
    },
    {
      "source": "/fpl-injuries",
      "destination": "/api/optimal-squad?page=injuries"
    },
    {
      "source": "/fpl-most-owned",
      "destination": "/api/optimal-squad?page=most-owned"
    },
    {
      "source": "/fpl-in-form",
      "destination": "/api/optimal-squad?page=form"
    },
    {
      "source": "/ext/predictions.json",
      "destination": "/api/optimal-squad?page=ext"
    },
    {
      "source": "/fpl-prediction-accuracy",
      "destination": "/api/optimal-squad?page=accuracy"
    },
    {
      "source": "/fpl-deadline",
      "destination": "/api/optimal-squad?page=deadline"
    },
    {
      "source": "/fpl-price-changes",
      "destination": "/api/optimal-squad?page=price-changes"
    },
    {
      "source": "/fpl-double-gameweek",
      "destination": "/api/optimal-squad?page=double"
    },
    {
      "source": "/fpl-blank-gameweek",
      "destination": "/api/optimal-squad?page=blank"
    },
    {
      "source": "/fpl-differentials",
      "destination": "/api/optimal-squad?page=differentials"
    },
    {
      "source": "/compare/:pair",
      "destination": "/api/optimal-squad?page=compare&pair=:pair"
    },
    {
      "source": "/indexnow-key.txt",
      "destination": "/api/optimal-squad?page=indexnow-key"
    },
    {
      "source": "/fpl-tips",
      "destination": "/api/optimal-squad?page=tips"
    },
    {
      "source": "/embed/captains",
      "destination": "/api/optimal-squad?page=embed"
    },
    {
      "source": "/league/:id",
      "destination": "/api/optimal-squad?page=league&id=:id"
    },
    {
      "source": "/images/best-xi.png",
      "destination": "/api/optimal-squad?page=xi-image"
    },
    {
      "source": "/fpl-predictions",
      "destination": "/api/optimal-squad?page=predictions"
    },
    {
      "source": "/fpl-players",
      "destination": "/api/optimal-squad?page=players"
    },
    {
      "source": "/player/:slug",
      "destination": "/api/optimal-squad?page=player&slug=:slug"
    },
    {
      "source": "/team/:slug",
      "destination": "/api/optimal-squad?page=team&slug=:slug"
    },
    {
      "source": "/gw/:n",
      "destination": "/api/optimal-squad?page=gw&n=:n"
    },
    {
      "source": "/sitemap-fpl.xml",
      "destination": "/api/optimal-squad?page=sitemap"
    },
    {
      "source": "/fpl-points-predictor",
      "destination": "/fpl-points-predictor/index.html"
    },
    {
      "source": "/fpl-captain-picks",
      "destination": "/fpl-captain-picks/index.html"
    },
    {
      "source": "/fpl-transfer-suggestions",
      "destination": "/fpl-transfer-suggestions/index.html"
    },
    {
      "source": "/rate-my-fpl-team",
      "destination": "/rate-my-fpl-team/index.html"
    },
    {
      "source": "/fpl-widget",
      "destination": "/fpl-widget/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!embed/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://fantasy.premierleague.com https://*.public.blob.vercel-storage.com; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; style-src 'unsafe-inline'; frame-ancestors *; base-uri 'none'; form-action 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "functions": {
    "api/optimal-squad.js": {
      "includeFiles": "src/lib/fonts/**"
    }
  }
}
