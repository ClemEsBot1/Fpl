{
  "manifest_version": 3,
  "name": "FPL Checker: Predicted Points for FPL",
  "short_name": "FPL Checker",
  "version": "1.0.0",
  "description": "Predicted points, your best captain and your team's score, right inside the official Fantasy Premier League site.",
  "homepage_url": "https://fplchecker.co.uk/fpl-chrome-extension",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FPL Checker",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://fplchecker.co.uk/*", "https://www.fplchecker.co.uk/*"],
  "content_scripts": [
    {
      "matches": ["https://fantasy.premierleague.com/*"],
      "js": ["lib.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["panel.css"],
      "matches": ["https://fantasy.premierleague.com/*"]
    }
  ]
}
